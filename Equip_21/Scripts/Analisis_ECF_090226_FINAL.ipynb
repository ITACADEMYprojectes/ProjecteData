    "import statsmodels.api as sm\n",
    "import statsmodels.formula.api as smf\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "INDICES = [\n",
    "    \"idx_estres_financiero\",\n",
    "    \"idx_uso_credito\",\n",
    "    \"idx_ahorro\"\n",
    "]\n",
    "\n",
    "CONTROL_VARS = \"C(estado_laboral) + C(edad_grupo) + C(cat_educacion) + C(riq_inmob) + C(familia)\"\n",
    "\n",
    "resultados = []\n",
    "\n",
    "for var in INDICES:\n",
    "    \n",
    "    formula = f\"{var} ~ comp_fin_bin + {CONTROL_VARS}\"\n",
    "    \n",
    "    modelo = smf.wls(\n",
    "        formula,\n",
    "        data=df,\n",
    "        weights=df[\"weight\"]\n",
    "    ).fit(cov_type=\"HC3\")\n",
    "    \n",
    "    coef = modelo.params[\"comp_fin_bin\"]\n",
    "    pval = modelo.pvalues[\"comp_fin_bin\"]\n",
    "    \n",
    "    resultados.append({\n",
    "        \"Indice\": var,\n",
    "        \"Coef_beta\": coef,\n",
    "        \"p_value\": pval,\n",
    "        \"R2\": modelo.rsquared\n",
    "    })\n",
    "\n",
    "resultados_indices = pd.DataFrame(resultados)\n",
    "resultados_indices\n"
   ]
