    "import numpy as np\n",
    "\n",
    "params = model_vuln.params\n",
    "conf = model_vuln.conf_int()\n",
    "\n",
    "odds = np.exp(params)\n",
    "conf_odds = np.exp(conf)\n",
    "\n",
    "results = pd.DataFrame({\n",
    "    \"OR\": odds,\n",
    "    \"CI_low\": conf_odds[0],\n",
    "    \"CI_high\": conf_odds[1],\n",
    "    \"p_value\": model_vuln.pvalues\n",
    "})\n",
    "\n",
    "results\n"
   ]
