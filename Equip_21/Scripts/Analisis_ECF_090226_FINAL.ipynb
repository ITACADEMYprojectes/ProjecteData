   "id": "de4704e5",
   "metadata": {},
   "outputs": [],
   "source": [
    "def categorizar_competencia(score):\n",
    "    if score <= 1:\n",
    "        return \"bajo\"\n",
    "    elif score == 2:\n",
    "        return \"medio\"\n",
    "    else:  # score == 3\n",
    "        return \"alto\"\n",
    "\n",
    "df[\"nivel_comp_fin\"] = df[\"score_comp_fin\"].apply(categorizar_competencia)"
   ]
  },
