   "source": [
    "# Nº de alojamientos por ciudad (inventario total, ordenado de mayor a menor).\n",
    "# Mantenemos el orden y coloreamos con un degradado azul de más oscuro (más\n",
    "# alojamientos) a más claro (menos).\n",
    "import numpy as np\n",
    "import matplotlib.cm as cm\n",
    "import matplotlib.colors as mcolors\n",
    "\n",
    "conteo_ciudad = df.groupby('city')['apartment_id'].count().sort_values(ascending=True)\n",
    "\n",
    "# normalizamos pero comprimiendo el rango: mínimo 0.35 en vez de 0\n",
    "valores_norm = mcolors.Normalize(vmin=conteo_ciudad.min(),\n",
    "                                 vmax=conteo_ciudad.max())(conteo_ciudad.values)\n",
    "colores = cm.Blues(0.35 + valores_norm * 0.65)   # rango 0.35 → 1.0\n",
    "\n",
    "fig, ax = plt.subplots()\n",
    "barras = ax.barh(conteo_ciudad.index, conteo_ciudad.values,\n",
    "                 color=colores, height=0.7)\n",
    "ax.bar_label(barras, fmt='%d', padding=3, fontsize=9, color=TINTA_SUAVE)\n",
    "ax.set_title('Número de alojamientos por ciudad')\n",
    "ax.set_xlabel('')\n",
    "ax.set_ylabel('Ciudad')\n",
    "ax.set_xticks([])\n",
    "ax.spines['bottom'].set_visible(False)\n",
    "ax.grid(False)\n",
    "ax.margins(x=0.12)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
