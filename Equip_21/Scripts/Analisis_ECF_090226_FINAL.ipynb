   ]
  },
  {
   "cell_type": "markdown",
   "id": "59a0cca3",
   "metadata": {},
   "source": [
    "#### A.4. Indicador categórico binario\n",
    "- competente = score ≥ 2\n",
    "- no competente = score ≤ 1"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 342,
   "id": "6cfa2564",
   "metadata": {},
   "outputs": [],
   "source": [
    "df[\"comp_fin_bin\"] = (df[\"score_comp_fin\"] >= 2).astype(int)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0623e436",
   "metadata": {},
   "source": [
    "#### B. Indicador de vulnerabilidad\n",
    "- Uso de préstamos para cubrir gastos\n",
    "- Morosidad\n",
    "- Denegaciones de préstamos\n",
    "\n",
    "Objetivo: Comprender las limitaciones de solvencia y estabilidad financiera."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 343,
   "id": "0cb2e60e",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "prestamo_gastos       0.101\n",
       "morosidad             0.027\n",
       "denegacion_credito    0.044\n",
       "uso_ahorros           0.132\n",
       "vulnerabilidad        0.235\n",
       "dtype: float64"
      ]
     },
     "execution_count": 343,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "# VARIABLES DE VULNERABILIDAD\n",
    "\n",
    "# 1. Uso de préstamos para cubrir gastos\n",
    "df[\"prestamo_gastos\"] = (\n",
    "    (df[\"cred_inf\"] == 1) |\n",
    "    (df[\"cred_form\"] == 1) |\n",
    "    (df[\"cred_add\"] == 1)\n",
    ").astype(int)\n",
    "\n",
    "# 2. Morosidad\n",
    "df[\"morosidad\"] = (df[\"impago\"] == 1).astype(int)\n",
    "\n",
    "# 3. Denegación de crédito\n",
    "df[\"denegacion_credito\"] = (\n",
    "    (df[\"rechazo\"] == 1) |\n",
    "    (df[\"semirechazo\"] == 1)\n",
    ").astype(int)\n",
    "\n",
    "# 4. Uso de ahorros para cubrir gastos\n",
    "df[\"uso_ahorros\"] = (df[\"consumo_ahorros\"] == 1).astype(int)\n",
    "\n",
    "\n",
    "# CÁLCULO DEL INDICADOR DE VULNERABILIDAD (1 si cumple al menos una condición)\n",
    "\n",
    "df[\"vulnerabilidad\"] = (\n",
    "    (df[\"prestamo_gastos\"] == 1) |\n",
    "    (df[\"morosidad\"] == 1) |\n",
    "    (df[\"denegacion_credito\"] == 1) |\n",
    "    (df[\"uso_ahorros\"] == 1)\n",
    ").astype(int)\n",
    "\n",
    "\n",
    "# CHECK\n",
    "\n",
    "df[[\n",
    "    \"prestamo_gastos\",\n",
    "    \"morosidad\",\n",
    "    \"denegacion_credito\",\n",
    "    \"uso_ahorros\",\n",
    "    \"vulnerabilidad\"\n",
    "]].mean().round(3)"
   ]
  },
