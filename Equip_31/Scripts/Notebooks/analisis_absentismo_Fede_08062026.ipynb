    "\n",
    "resultados_spearman = []\n",
    "for variable in variables_numericas_tests:\n",
    "    rho, p_value = stats.spearmanr(\n",
    "        df_empleados_tests[variable],\n",
    "        df_empleados_tests['horas_totales'],\n",
    "        nan_policy='omit'\n",
    "    )\n",
    "    resultados_spearman.append({\n",
    "        'variable': variable,\n",
