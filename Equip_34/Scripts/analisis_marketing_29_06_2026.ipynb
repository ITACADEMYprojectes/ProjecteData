    "Precio por tipo de alojamiento"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 40,
   "id": "47da4e1b",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1210x660 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Precio medio por tipo de alojamiento, agrupado en dos bloques de coste:\n",
    "#   - HIGH COST -> tonos amarillos (más caro = más oscuro)\n",
    "#   - LOW COST  -> tonos verdes   (más caro = más oscuro)\n",
    "serie_tipo = df_precio.groupby('room_type')[PRECIO].mean().sort_values(ascending=False)\n",
    "\n",
    "fig, ax = plt.subplots()\n",
    "barras = ax.bar(serie_tipo.index, serie_tipo.values,\n",
    "                color=[COLOR_TIPO[t] for t in serie_tipo.index], width=0.7)\n",
    "ax.bar_label(barras, fmt='%.0f €', padding=3, fontsize=9, color=TINTA_SUAVE)\n",
    "ax.set_title('Precio medio por tipo de alojamiento')\n",
    "ax.set_xlabel('Tipo de alojamiento')\n",
    "ax.set_ylabel('')\n",
    "ax.set_yticks([])                       # quitamos los números del eje Y\n",
    "ax.spines['left'].set_visible(False)\n",
    "ax.grid(False)\n",
    "ax.margins(y=0.12)\n",
    "\n",
    "# Leyenda de los dos grupos de coste (colores del logo)\n",
    "grupos = [Patch(facecolor=AMARILLO, label='High cost'),\n",
    "          Patch(facecolor=VERDE, label='Low cost')]\n",
    "ax.legend(handles=grupos, title='Grupo de coste', frameon=False, loc='upper right')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
