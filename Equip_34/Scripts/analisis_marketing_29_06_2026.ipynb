   "source": [
    "# Nº de alojamientos por ciudad y tipo (inventario total).\n",
    "# Mismo orden de ciudades que \"Precio medio por ciudad y tipo de alojamiento\"\n",
    "# (por precio medio, de mayor a menor) y mismos colores por tipo (high/low cost).\n",
    "orden_ciudad_conteo = df_precio.groupby('city')[PRECIO].mean().sort_values(ascending=False).index\n",
    "orden_tipo_conteo = df_precio.groupby('room_type')[PRECIO].mean().sort_values(ascending=False).index\n",
    "\n",
    "conteo_ciudad_tipo = (\n",
    "    df.pivot_table(index='city', columns='room_type', values='apartment_id', aggfunc='count')\n",
    "    .reindex(orden_ciudad_conteo)\n",
    "    .reindex(columns=orden_tipo_conteo)\n",
    ")\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(13, 6.5))\n",
    "conteo_ciudad_tipo.plot(kind='bar', ax=ax, width=0.8,\n",
    "                        color=[COLOR_TIPO[t] for t in conteo_ciudad_tipo.columns],\n",
    "                        edgecolor='white', linewidth=0.5)\n",
    "\n",
    "# Número de conteo encima de cada barra (se omiten las combinaciones sin datos)\n",
    "for contenedor in ax.containers:\n",
    "    etiquetas = [f'{int(barra.get_height())}'\n",
    "                 if barra.get_height() == barra.get_height() and barra.get_height() > 0 else ''\n",
    "                 for barra in contenedor]\n",
    "    ax.bar_label(contenedor, labels=etiquetas, padding=2, fontsize=12,\n",
    "                 color=TINTA_SUAVE, rotation=0)\n",
    "\n",
    "ax.set_title('Número de alojamientos por ciudad y tipo de alojamiento')\n",
    "ax.set_xlabel('Ciudad')\n",
    "ax.set_ylabel('Nº de alojamientos')     # se conserva el nombre del eje Y\n",
    "ax.set_yticks([])                       # se quitan los números del eje Y\n",
    "ax.grid(False)\n",
    "ax.margins(y=0.14)\n",
    "ax.tick_params(axis='x', rotation=30)\n",
    "for etiqueta in ax.get_xticklabels():\n",
    "    etiqueta.set_ha('right')\n",
    "ax.legend(title='Tipo de alojamiento', frameon=False, ncol=2)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
