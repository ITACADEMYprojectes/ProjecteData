    "        'p_value': round(p_value, 4),\n",
    "        'significativo_p_005': 'Sí' if p_value < 0.05 else 'No'\n",
    "    })\n",
    "\n",
    "spearman_tests = (\n",
    "    pd.DataFrame(resultados_spearman)\n",
    "    .sort_values('rho_spearman', key=lambda s: s.abs(), ascending=False)\n",
    ")\n",
    "\n",
    "spearman_tests\n"
