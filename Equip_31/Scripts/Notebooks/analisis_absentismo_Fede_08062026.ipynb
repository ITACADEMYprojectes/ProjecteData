    "variables_categoricas_top80 = ['Education_name', 'Social_drinker', 'Social_smoker', 'Disciplinary_failure']\n",
    "\n",
    "resumen_categorico_top80 = []\n",
    "for variable in variables_categoricas_top80:\n",
    "    top = (df_top80[variable].value_counts(normalize=True) * 100).round(1)\n",
    "    resto = (df_resto[variable].value_counts(normalize=True) * 100).round(1)\n",
    "    tabla = pd.DataFrame({\n",
    "        'variable': variable,\n",
    "        'categoria': sorted(set(top.index).union(set(resto.index))),\n",
    "    })\n",
    "    tabla['pct_top80'] = tabla['categoria'].map(top).fillna(0)\n",
    "    tabla['pct_resto'] = tabla['categoria'].map(resto).fillna(0)\n",
    "    resumen_categorico_top80.append(tabla)\n",
    "\n",
    "resumen_categorico_top80 = pd.concat(resumen_categorico_top80, ignore_index=True)\n",
    "resumen_categorico_top80"
