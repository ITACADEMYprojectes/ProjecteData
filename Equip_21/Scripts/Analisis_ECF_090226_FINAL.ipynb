   "source": [
    "def make_pivot_index(df, group_col):\n",
    "    \"\"\"\n",
    "    Строит сводную таблицу:\n",
    "    group_col vs поведенческие индексы\n",
    "    \"\"\"\n",
    "\n",
    "    tab = (\n",
    "        df\n",
    "        .groupby(group_col)[\n",
    "            [\"idx_estres_financiero\",\n",
    "             \"idx_uso_credito\",\n",
    "             \"idx_ahorro\"]\n",
    "        ]\n",
    "        .mean()\n",
    "        .round(2)\n",
    "    )\n",
    "\n",
    "    # Добавим размер группы\n",
    "    tab[\"N\"] = df.groupby(group_col).size()\n",
    "\n",
    "    return tab.reset_index()\n"
   ]
  },
